# Loose design source images stay local — but the /assets/ folder
# ships published icons (hosted via raw.githubusercontent for the userscript).
*.png
*.jpg
*.jpeg
!assets/**/*.png
!assets/**/*.jpg
!assets/**/*.jpeg

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Temp scratch files
*.tmp
*.bak
*~

# User fight exports (generated by exportFights() — personal data,
# not source). Matches the default filename pattern from the panel.
torniq-fights-*.json
tech-fights-*.json

# Third-party userscripts kept locally for reference during integration
# work (FF Scouter, etc.). Not part of TECH's distribution.
references/

# Working-tree backups from staged refactor work.
.tech-*-backup.js

# Spy/calibration datasets — aggregate-only outputs ship in source as
# constants (TYPICAL_STATS_BY_LEVEL etc.); the raw individual-spy rows
# must NEVER reach GitHub. The players in those files have a reasonable
# expectation their stats stay inside TornStats, not republished publicly.
TS_Faction_Spies_*.csv
*_spies_*.csv
*spy*.csv
